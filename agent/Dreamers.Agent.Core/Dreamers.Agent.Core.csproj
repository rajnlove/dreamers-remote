<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Dreamers.Agent.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Not just .Abstractions: RollingFileLoggerExtensions uses
         ILoggingBuilder.AddProvider(), which lives in the main
         Microsoft.Extensions.Logging package (it depends on
         .Abstractions, so both are available transitively). -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <!-- CPU name/core count and OS caption/version — the only clean,
         reliable way to get both in one query without hand-rolled SMBIOS/
         registry parsing. Windows-only, matches this project's target. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- Windows DPAPI wrapper — protects the agent credential at rest
         without inventing our own crypto (see docs/SECURITY.md). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
