# Copy outside the repository, restrict read permissions, and fill all blank values.
UPLOAD_IMAGE_TAG=
UPLOAD_UID=3001
UPLOAD_GID=3001
UPLOAD_BIND_IP=192.168.1.92
UPLOAD_HOST_PORT=18090
# Selected location: \\192.29.11.92\web_data\www\online\dreamers-upload.
# This is under a web root: block its direct HTTP route before storing any media.
# Verified in TrueNAS web-online Volume Mounts and its container shell.
UPLOAD_HOST_STORAGE=/mnt/pool_cgivn_work/web_data/www/online/dreamers-upload
# SQLite is kept in private Docker volume dreamers-upload-state, outside www.
# This UNC folder must refer to exactly the same directory as UPLOAD_HOST_STORAGE.
# Single quotes preserve backslashes in Compose .env parsing.
UPLOAD_WORKER_ROOT='\\192.29.11.92\web_data\www\online\dreamers-upload'
UPLOAD_ENGINE_URL=http://192.168.1.92:8080
UPLOAD_ENGINE_USERNAME=
UPLOAD_ENGINE_PASSWORD=
UPLOAD_USERNAME=
UPLOAD_PASSWORD=
UPLOAD_MAX_FILE_GB=20
UPLOAD_QUOTA_GB=100
UPLOAD_DISK_RESERVE_GB=10
