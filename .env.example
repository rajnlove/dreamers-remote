# --- Server API, DB, TrueNAS deployment ---
# PLACEHOLDER — TrueNAS host/app port.
APP_PORT=8080

# PLACEHOLDER — set to the real dataset path, e.g. /mnt/<POOL>/apps/dreamers-remote
DATA_ROOT=./data

# SQLite file path inside the server container (relative to DATA_ROOT mount).
DATABASE_FILE=/data/dreamers-remote.sqlite

# Session/auth secret (Milestone 6). Generate with: openssl rand -hex 32
SESSION_SECRET=changeme-generate-a-real-secret

# Milestone 6: single admin account, seeded on first boot only (a user
# already existing in the DB means these are ignored). Change the
# password after first login isn't implemented yet — pick a real one now.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-set-a-real-password

# P4-5: PHP Projects site's service account -- non-admin, logs in via
# POST /api/login and reuses the session cookie to call POST /api/jobs.
# Leave PHP_SERVICE_PASSWORD unset to disable PHP integration entirely
# (no account created, no warning logged -- unlike ADMIN_PASSWORD above,
# this one is optional). Idempotent per-username on every boot, same as
# the admin account.
PHP_SERVICE_USERNAME=php-service
PHP_SERVICE_PASSWORD=changeme-set-a-real-password

# Separate non-admin Upload portal service account; leave password blank to disable.
# Generate a fresh random password of at least 32 characters; never reuse PHP test credentials.
UPLOAD_SERVICE_USERNAME=upload-portal
UPLOAD_SERVICE_PASSWORD=
