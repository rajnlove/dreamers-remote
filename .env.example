# --- Milestone 1: noVNC / websockify proof of concept ---
# The first Windows workstation you're testing against (see docs/SETUP.md).
# PLACEHOLDER — replace with a real LAN IP before starting docker compose.
VNC_TARGET_HOST=192.29.11.95
VNC_TARGET_PORT=5900

# Port noVNC's web UI is served on.
NOVNC_PORT=6080

# --- Later milestones (server API, DB, TrueNAS deployment) ---
# PLACEHOLDER — TrueNAS host/app port.
APP_PORT=8080

# PLACEHOLDER — set to the real dataset path, e.g. /mnt/<POOL>/apps/dreamers-remote
DATA_ROOT=./data

# SQLite file path inside the server container (relative to DATA_ROOT mount).
DATABASE_FILE=/data/dreamers-remote.sqlite

# Session/auth secret (Milestone 6). Generate with: openssl rand -hex 32
SESSION_SECRET=changeme-generate-a-real-secret

# Milestone 6: single admin account, seeded on first boot only (a user
# already existing in the DB means these are ignored). Change the
# password after first login isn't implemented yet — pick a real one now.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-set-a-real-password
