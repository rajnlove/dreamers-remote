{
  "name": "dreamers-remote-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:upload": "node dist/upload/main.js",
    "test:upload": "tsx --test src/upload/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/workstation/*.test.ts src/wol/*.test.ts src/auth/*.test.ts src/agent/*.test.ts src/job/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
